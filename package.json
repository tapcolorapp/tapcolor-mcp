    "claude",
    "llm"
  ],
  "homepage": "https://developer.tapcolor.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapcolorapp/tapcolor-mcp.git"
  },
  "bugs": { "url": "https://tapcolor.app/contact/" },
  "author": "TapColor",
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@tapcolorapp/api": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
