{
  "name": "@tapcolorapp/mcp",
  "version": "1.0.0",
  "description": "MCP server for the TapColor Developer API — let AI assistants browse coloring categories and collections.",
  "type": "module",
  "bin": { "tapcolor-mcp": "dist/index.js" },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "prepublishOnly": "npm run build"
